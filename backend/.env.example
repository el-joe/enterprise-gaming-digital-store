APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gaming-store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production.
SESSION_SECURE_COOKIE=
ADMIN_IDLE_MINUTES=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required only when running: php artisan db:seed --class=SuperAdminSeeder
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Open Exchange Rates (awaiting credentials). May be set in settings instead: currency.oxr_app_id
OPEN_EXCHANGE_RATES_APP_ID=

# Digital code keyring (separate from APP_KEY; back up separately). Comma-separated kid:base64 pairs, 32-byte keys.
# Generate a key with: php -r 'echo base64_encode(random_bytes(32));'
DIGITAL_CODE_KEYS=
DIGITAL_CODE_ACTIVE_KID=
DIGITAL_CODE_BLIND_INDEX_KEY=

# Payments (M10). Gateway credentials and webhook secrets are stored encrypted in
# payment_gateway_credentials, never in the environment. Return page for the provider redirect.
PAYMENTS_RETURN_URL=
STRIPE_API_VERSION=
# GeoIP for eligibility: null (default) or header (only behind a trusted edge proxy such as Cloudflare).
GEOIP_DRIVER=
GEOIP_COUNTRY_HEADER=

# MCP API (M16). Empty values use the defaults in config/mcp.php (15 minutes, 20 percent,
# 10.00 in the base currency, 90 days). Tokens are issued with `php artisan mcp:token issue`.
MCP_PENDING_ACTION_TTL_MINUTES=
MCP_COUPON_TIER1_MAX_PERCENT=
MCP_COUPON_TIER1_MAX_FIXED_BASE=
MCP_TOKEN_TTL_DAYS=

# n8n automation (M17, docs/N8N_AUTOMATIONS.md). Leave the outbox disabled until n8n exists.
AUTOMATION_TOKEN_TTL_DAYS=
AUTOMATION_OUTBOX_ENABLED=
AUTOMATION_STORE_NAME=
N8N_WEBHOOK_URL=
N8N_OUTBOUND_SECRET=
N8N_WEBHOOK_AUTH_TOKEN=
