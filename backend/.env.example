# Only the Super Admin and the technical bootstrap keys live here (owner decision 11, docs/OWNER_DECISIONS.md).
# Everything else (store name and address, languages, sessions, mail, files and S3, the code-vault
# keys, token lifetimes, timeouts, payment return links, n8n, push, GeoIP, MCP, ...) is an admin
# setting: Admin > Settings, stored in the `settings` table (secrets and the code-vault keys
# encrypted with APP_KEY) and applied over config at boot. docs/DEPLOYMENT.md 3.1 explains why each
# key below must stay; 3.2 lists where every former key lives now.
#
# Upgrading an installation whose .env still holds the old keys: copy them once, then delete them here:
#   php artisan config:clear && php artisan settings:import-env
# A new installation: php artisan migrate --seed (generates the code-vault keys), then set the
# store address and mail in Admin > Settings.

# Owner's choice: the first Super Admin (php artisan db:seed --class=SuperAdminSeeder).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Decrypts every encrypted setting, including the code-vault keys. Back it up apart from the database.
APP_KEY=
# APP_PREVIOUS_KEYS=

# Read before the application boots.
APP_ENV=local
APP_DEBUG=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging must work while the database is down.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The database the settings are read from.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gaming-store
DB_USERNAME=root
DB_PASSWORD=

# Infrastructure the settings overlay itself depends on (its cache), or that runs before the
# database is reachable. CACHE_PREFIX and REDIS_PREFIX default to boxcards-cache- / boxcards-database-.
SESSION_DRIVER=database
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=

# Compiled into the frontend by `npm run build`, so it cannot come from the database.
VITE_APP_NAME="boxcards.shop"
