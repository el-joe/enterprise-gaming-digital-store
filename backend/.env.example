APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gaming-store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required only when running: php artisan db:seed --class=SuperAdminSeeder
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Digital code keyring (separate from APP_KEY; back up separately). Comma-separated kid:base64 pairs, 32-byte keys.
# Generate a key with: php -r 'echo base64_encode(random_bytes(32));'
DIGITAL_CODE_KEYS=
DIGITAL_CODE_ACTIVE_KID=
DIGITAL_CODE_BLIND_INDEX_KEY=

# Payments (M10). Gateway credentials and webhook secrets are stored encrypted in
# payment_gateway_credentials, never in the environment. ADR-023: the Stripe API version is pinned
# with the code that parses its responses, so it stays here.
STRIPE_API_VERSION=

# Settings from the database (docs/PROGRESS.md "Settings from the database"). These former .env
# keys are now admin settings edited in Admin > Settings, stored in the `settings` table (secrets
# encrypted with APP_KEY) and applied over config at boot:
#   payment return URLs, OPEN_EXCHANGE_RATES_APP_ID, GEOIP_*, MCP_*, AUTOMATION_*, N8N_*,
#   PASSWORD_RESET_URL, EMAIL_VERIFIED_URL, MOBILE_ANDROID_PACKAGES,
#   MOBILE_ANDROID_SHA256_FINGERPRINTS, MOBILE_IOS_APP_IDS, MOBILE_WEB_CHECKOUT_*,
#   MOBILE_FORGOT_PASSWORD_URL, MOBILE_BIOMETRIC_CHALLENGE_TTL_SECONDS, FCM_* (the service-account
#   JSON itself, not a path), STOREFRONT_GUEST_CHECKOUT, ADMIN_THEME, ADMIN_IDLE_MINUTES,
#   SEO_BLOCK_ALL_CRAWLERS.
# An existing installation copies its current values once with:
#   php artisan config:clear && php artisan settings:import-env
# then removes those lines from .env (see docs/DEPLOYMENT.md).

# M18 SEO: the disk the sitemaps are written to (infrastructure). Blocking crawlers, GA4, GTM and
# Search Console are admin settings, never environment values.
SEO_SITEMAP_DISK=local
