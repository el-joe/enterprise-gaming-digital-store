        {
            "id": "b37b749c-6c8a-4f4b-8b4e-1430d3963571",
            "name": "Verify signature",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                480,
                300
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const crypto = require('crypto');\n// Laravel signs: X-Signature = hex HMAC-SHA256(X-Signature-Timestamp + \".\" + raw body, N8N_OUTBOUND_SECRET).\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst secret = String($env.EGS_OUTBOUND_SECRET || '');\nconst raw = item.binary && item.binary.data ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8') : '';\nconst timestamp = String(headers['x-signature-timestamp'] || '');\nconst signature = String(headers['x-signature'] || '');\nconst fresh = /^[0-9]+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst expected = secret === '' ? '' : crypto.createHmac('sha256', secret).update(timestamp + '.' + raw).digest('hex');\nconst valid = secret !== '' && fresh && signature.length === expected.length && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\nlet event = null;\nif (valid) {\n  try {\n    event = JSON.parse(raw);\n  } catch (error) {\n    event = null;\n  }\n}\nreturn [{ json: { valid: valid && event !== null && typeof event.event_id === 'string', event } }];"
            }
        },
