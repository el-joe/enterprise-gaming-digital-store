            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const crypto = require('crypto');\n// Signs a request to the Laravel automation API (docs/API_DOCUMENTATION.md section 7).\n// Canonical string: timestamp, nonce, METHOD, path with query, workflow id, execution key, raw body.\nconst signRequest = (method, path, body, ctx) => {\n  const base = String($env.EGS_API_BASE_URL || '').replace(/\\/+$/, '');\n  const secret = String($env.EGS_AUTOMATION_HMAC_SECRET || '');\n  if (!base || !secret) {\n    throw new Error('EGS_API_BASE_URL and EGS_AUTOMATION_HMAC_SECRET must be set in the n8n environment.');\n  }\n  const uri = '/api/v1/automation/' + String(path).replace(/^\\/+/, '');\n  const raw = body === null ? '' : JSON.stringify(body);\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const nonce = crypto.randomBytes(16).toString('hex');\n  const canonical = [timestamp, nonce, method, uri, ctx.workflow_id, ctx.execution_key, raw].join('\\n');\n  const signature = crypto.createHmac('sha256', secret).update(canonical).digest('hex');\n  return {\n    method,\n    url: base + uri,\n    body: raw,\n    headers: {\n      'Accept': 'application/json',\n      'X-Workflow-Id': ctx.workflow_id,\n      'X-Execution-Key': ctx.execution_key,\n      'X-Automation-Timestamp': timestamp,\n      'X-Automation-Nonce': nonce,\n      'X-Automation-Signature': signature,\n    },\n  };\n};\nconst input = $input.first().json;\nconst execution = input.execution || {};\nconst failed = input.workflow || {};\nconst trigger = input.trigger || {};\nconst error = execution.error || trigger.error || {};\nconst failedName = String(failed.name || 'unknown workflow');\nconst match = failedName.match(/^([A-Z][0-9]{2})\\b/);\nconst failedId = match ? match[1] : null;\nconst executionId = String(execution.id || ('trigger-' + Date.now()));\nconst ctx = { workflow_id: 'Z01', execution_key: 'Z01:' + executionId.replace(/[^A-Za-z0-9:._-]/g, '-').slice(0, 120) };\nconst message = String(error.message || 'No error message').slice(0, 1000);\nconst alert = {\n  severity: 'critical',\n  title: ('Workflow ' + failedName + ' failed').slice(0, 190),\n  message,\n  failed_workflow_id: failedId,\n  n8n_execution_id: execution.id ? String(execution.id).slice(0, 64) : null,\n  node: execution.lastNodeExecuted ? String(execution.lastNodeExecuted).slice(0, 190) : null,\n};\nreturn [{ json: {\n  request: signRequest('POST', 'alerts', alert, ctx),\n  notify: failedId !== 'Z02',\n  severity: 'critical',\n  title: alert.title,\n  text: message + (alert.node ? '\\nLast node: ' + alert.node : '') + (execution.url ? '\\nExecution: ' + execution.url : ''),\n  source: 'Z01',\n} }];"
            }
        },
