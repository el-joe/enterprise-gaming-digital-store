# Local n8n for boxcards.shop. Copy to .env (git-ignored); install-user-service.sh does this for you
# and fills N8N_ENCRYPTION_KEY with a random value. Back that key up: credentials can't be decrypted without it.

# --- server (behind Apache: http://n8n.boxcards.loc -> 127.0.0.1:5710) ---
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5710
N8N_HOST=n8n.boxcards.loc
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n.boxcards.loc/
WEBHOOK_URL=http://n8n.boxcards.loc/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false

# --- storage (own folder; separate from any other n8n on this machine) ---
N8N_USER_FOLDER=/var/www/enterprise-gaming-digital-store/n8n/runtime/data
N8N_RESTRICT_FILE_ACCESS_TO=/var/www/enterprise-gaming-digital-store/n8n/runtime/data/files
N8N_ENCRYPTION_KEY=
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
DB_TYPE=sqlite
DB_SQLITE_POOL_SIZE=2

# --- behaviour ---
GENERIC_TIMEZONE=Africa/Cairo
TZ=Africa/Cairo
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
# Other local n8n instances already use 5678-5679 (3alraf) and 5690-5691 (hrm-plus); this one uses 5710 (app) and 5711 (task broker)
N8N_RUNNERS_BROKER_PORT=5711
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# isolated-vm is stubbed (no native build), so use the legacy expression engine
N8N_EXPRESSION_ENGINE=legacy
# no shell, SSH or local-file nodes; Code nodes may use crypto (HMAC signing) only
NODES_EXCLUDE='["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger","n8n-nodes-base.ssh"]'
NODE_FUNCTION_ALLOW_BUILTIN=crypto
NODE_FUNCTION_ALLOW_EXTERNAL=
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_LOG_FILE_LOCATION=/var/www/enterprise-gaming-digital-store/n8n/runtime/data/logs/n8n.log

# --- variables the workflows read through $env (see n8n/README.md) ---
EGS_API_BASE_URL=http://boxcards.loc
EGS_STOREFRONT_URL=http://boxcards.loc
# printed once by: cd backend && php artisan automation:credentials issue
EGS_AUTOMATION_HMAC_SECRET=
# must equal N8N_OUTBOUND_SECRET in backend/.env
EGS_OUTBOUND_SECRET=
# slack or telegram (BD9 still open)
EGS_ALERT_CHANNEL=
EGS_SLACK_CHANNEL_ID=
EGS_TELEGRAM_CHAT_ID=
EGS_SMS_API_URL=
EGS_LLM_MODEL=
EGS_N8N_DRIVES_PAYMENT_RECONCILIATION=false
