<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark first in every system mode: the launch window and the window behind
         Flutter use ink-950 so there is no white flash before the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink_950</item>
    </style>
</resources>
