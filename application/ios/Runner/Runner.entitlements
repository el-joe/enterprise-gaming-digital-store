<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Associated domains for universal links (M-A13, ADR-039): payment return/cancel links and product
  pages on the flavor's APP_LINK_HOST. Placeholder until the macOS build host (M-A20):
  - set APP_LINK_HOST per scheme/flavor in its xcconfig to the value of
    lib/core/config/env_<flavor>.json (never a hard-coded production host);
  - set CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements and enable the Associated Domains
    capability with the owner's Team ID;
  - the server publishes TEAMID.<bundle id> in MOBILE_IOS_APP_IDS (apple-app-site-association).
  Not referenced by the Xcode project yet, so unsigned and simulator builds are unaffected.

  Push notifications (M-A18, owner decision 9): aps-environment is the Push Notifications
  capability. Placeholder for the macOS host: enable "Push Notifications" and "Background Modes >
  Remote notifications" in Xcode, use "production" for App Store and TestFlight builds, and
  upload the APNs authentication key (.p8) to the Firebase project (Project settings > Cloud
  Messaging > Apple app configuration). Each flavor's GoogleService-Info.plist is supplied by the
  owner and never committed (README, push).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(APP_LINK_HOST)</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
